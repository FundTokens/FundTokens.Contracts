{
  "name": "@fundtokens/fund-tokens-contracts",
  "author": "Fun(d)Tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@bitauth/libauth": "3.1.0-next.8",
    "cashc": "0.13.0",
    "cashscript": "0.13.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:build": "yarn build && yarn test",
    "test:watch": "vitest",
    "build": "yarn build:fund && yarn build:startup && yarn build:vault && yarn build:system",
    "build:fund": "cashc ./contracts/manager.cash --output ./lib/art/manager.json && cashc ./contracts/fund.cash --output ./lib/art/fund.json && cashc ./contracts/asset.cash --output ./lib/art/asset.json",
    "build:startup": "cashc ./contracts/public.cash --output ./lib/art/public.json && cashc ./contracts/startup.cash --output ./lib/art/startup.json && cashc ./contracts/fee.cash --output ./lib/art/fee.json && cashc ./contracts/mint_inflow.cash --output ./lib/art/mint_inflow.json && cashc ./contracts/mint_outflow.cash --output ./lib/art/mint_outflow.json",
    "build:vault": "cashc ./contracts/simple_vault.cash --output ./lib/art/simple_vault.json && cashc ./contracts/authhead_vault.cash --output ./lib/art/authhead_vault.json && cashc ./contracts/public_vault.cash --output ./lib/art/public_vault.json",
    "build:system": "cashc ./contracts/fee_minter.cash --output ./lib/art/fee_minter.json && cashc ./contracts/simple_minter.cash --output ./lib/art/simple_minter.json && cashc ./contracts/instance_vault.cash --output ./lib/art/instance_vault.json",
    "metrics": "node ./metrics/analyzeContracts.js",
    "metrics:build": "yarn build && yarn metrics"
  },
  "devDependencies": {
    "msw": "^2.15.0",
    "vitest": "^4.0.18"
  }
}
