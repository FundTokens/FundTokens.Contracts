{
  "name": "@fundtokens/builders",
  "version": "0.2.0-rc1",
  "description": "Transaction builders and registry client to create and interact with FundTokens.",
  "author": "Fun(d)Tokens",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "BitcoinCash",
    "Bitcoin Cash",
    "Bitcoin",
    "CashTokens",
    "DeFi",
    "FundTokens"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "default": "./dist/registry/index.js"
    },
    "./token-basket": {
      "types": "./dist/fund-types/token-basket/index.d.ts",
      "default": "./dist/fund-types/token-basket/index.js"
    },
    "./token-basket/v1": {
      "types": "./dist/fund-types/token-basket/v1/index.d.ts",
      "default": "./dist/fund-types/token-basket/v1/index.js"
    },
    "./token-basket/v1/artifacts/*.json": "./dist/fund-types/token-basket/v1/artifacts/*.json",
    "./weighted-bch-usd": {
      "types": "./dist/fund-types/weighted-bch-usd/index.d.ts",
      "default": "./dist/fund-types/weighted-bch-usd/index.js"
    },
    "./weighted-bch-usd/v1": {
      "types": "./dist/fund-types/weighted-bch-usd/v1/index.d.ts",
      "default": "./dist/fund-types/weighted-bch-usd/v1/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/tests",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "yarn clean && tsc -p tsconfig.build.json && tsx scripts/copy-artifacts.ts",
    "build:contracts": "tsx scripts/build-contracts.ts",
    "build:contracts:force": "tsx scripts/build-contracts.ts --force",
    "check:contracts": "tsx scripts/build-contracts.ts --check",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "yarn check:contracts && yarn typecheck && yarn test && yarn build",
    "metrics": "tsx metrics/analyzeContracts.ts",
    "metrics:compare": "tsx metrics/compareContracts.ts",
    "prepack": "yarn build",
    "prepublishOnly": "yarn check:contracts && yarn typecheck && yarn test"
  },
  "dependencies": {
    "@bitauth/libauth": "3.1.0-next.8",
    "cashscript": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "cashc": "0.13.0",
    "msw": "^2.15.0",
    "tsx": "^4",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
