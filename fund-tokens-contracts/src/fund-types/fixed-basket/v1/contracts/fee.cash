pragma cashscript ^0.14.0;

import "./lib/authority.cash";

/**
 * FeeManager: Validates fee payments are paid and routed using the default payment or by using the fee NFT
 * 
 * Every FundToken operation pays fees through this contract.
 * Validates that fees match their encoding and route to correct destination.
 * 
 * Parameters:
 *   authToken: Authorization token (controls who can close)
 *   defaultDestination: Default destination locking bytecode
 *   feeToken: Fee token category (with expected 'none' capability)
 *   defaultValue: Default fee amount in satoshis
 */
contract FeeManager(bytes32 authToken, bytes defaultDestination, bytes32 feeToken, int defaultValue)
{
    /**
     * close(): Close this fee by ensuring all fee tokens are burned
     * 
     * Allows protocol steward to close the fees and cleanup stale UTXOs.
     * 
     * Ensures:
     * - Transaction includes authToken with bit 0x0020 (fee close permission)
     * - All fee NFT tokens must be implicitly burned: no output carries the fee category,
     *   whatever its capability
     */
    function close() {
        //
        // Verify all fee tokens are implicitly burned
        int outputIndex = 0;
        do {
            // Compare the category's first 32 bytes: mutable and minting NFTs append a capability byte
            // A tokenless output compares the authorization category, which is never the fee category
            require(bytes(tx.outputs[outputIndex].tokenCategory + authToken).split(32)[0] != feeToken);
            // Nothing returns to this contract, so a FeeManager input that does return ran pay()
            require(tx.outputs[outputIndex].lockingBytecode != tx.inputs[this.activeInputIndex].lockingBytecode);
            outputIndex = outputIndex + 1;
        } while(outputIndex < tx.outputs.length);

        //
        // Check for authorization token in any input
        // Bit 0x0020 in commitment indicates fee manager closure permission
        require(hasAuthority(authToken, 0x0020), "unauthorized user");
    }

    /**
     * pay(): Validate fee payment according to provided UTXO, default or use NFT commitment encoding
     * 
     * Routes fee to destination encoded in fee token NFT or use default destination.
     * Supports two fee types: Bitcoin and CashTokens.
     * 
     * Ensures:
     * - This UTXO returns to itself (no state change)
     * - Fee amount is at least the encoded amount (satoshis or token)
     * - Fee routes to correct destination (from encoding or default)
     * - Token category (if token fee) matches encoding
     */
    function pay() {
        //
        // Verify this input and UTXO is preserved
        require(tx.inputs[this.activeInputIndex].lockingBytecode == tx.outputs[this.activeInputIndex].lockingBytecode);
        require(tx.inputs[this.activeInputIndex].tokenAmount == tx.outputs[this.activeInputIndex].tokenAmount);
        require(tx.inputs[this.activeInputIndex].nftCommitment == tx.outputs[this.activeInputIndex].nftCommitment);
        int feeOutput = this.activeInputIndex + 1;
        bytes thisInputCategory = tx.inputs[this.activeInputIndex].tokenCategory;
        require(thisInputCategory == tx.outputs[this.activeInputIndex].tokenCategory);

        //
        // Check for encoded fee or default
        if(thisInputCategory == feeToken) {
            //
            // Check fee type to enforce or voluntary
            bytes fee_type, bytes fee_next0 = tx.inputs[this.activeInputIndex].nftCommitment.split(1);
            require(fee_type == 0x01 || fee_type == 0x02);

            if(fee_type == 0x01) {
                //
                // Continue reading from the NFT to enforce the encoded fee
                bytes fee_category, bytes fee_next1 = fee_next0.split(32);
                bytes fee_amount_bytes, bytes fee_destination = fee_next1.split(8);

                //
                // Verify fee routed to correct destination
                if(fee_destination.length > 0) {
                    require(tx.outputs[feeOutput].lockingBytecode == fee_destination);
                } else {
                    require(tx.outputs[feeOutput].lockingBytecode == defaultDestination);
                }

                //
                // Verify the fee is paid
                int fee_amount = int(fee_amount_bytes);
                if(int(fee_category) == 0) {
                    require(tx.outputs[feeOutput].value == fee_amount);
                    require(tx.outputs[feeOutput].tokenCategory == 0x);
                } else {
                    require(tx.outputs[feeOutput].tokenCategory == fee_category);
                    require(tx.outputs[feeOutput].tokenAmount == fee_amount);
                }
            } else {
                //
                // fee_type == 0x02
                // default destination w/ a fungible token or an OP_RETURN w/ no BCH or tokens
                if(tx.outputs[feeOutput].lockingBytecode == defaultDestination) {
                    require(tx.outputs[feeOutput].tokenCategory.length == 32 || (tx.outputs[feeOutput].tokenCategory == 0x && tx.outputs[feeOutput].value > 0));
                } else {
                    require(tx.outputs[feeOutput].lockingBytecode.slice(0, 1) == 0x6a);
                    require(tx.outputs[feeOutput].tokenCategory == 0x);
                    require(tx.outputs[feeOutput].value == 0);
                }
            }
        } else {
            //
            // Verify default route and at least default sats are paid
            require(tx.outputs[feeOutput].lockingBytecode == defaultDestination);
            require(tx.outputs[feeOutput].value == defaultValue);
            require(tx.outputs[feeOutput].tokenCategory == 0x);
        }
    }
}
