pragma cashscript ^0.14.0;

/**
 * ReserveVault: Holds the USD reserves of a weighted BCH/USD fund's shards
 *
 * Each shard's reserve is created at the output right after its shard, in the same transaction,
 * and every operation recreates the pair the same way. So a reserve belongs to the shard whose
 * outpoint is just before its own. The ShardManager checks everything about the reserve's output;
 * this contract only proves the reserve moves with its own shard.
 *
 * Mutable NFTs of the fund category exist only as shards (all minted at genesis, with no minting
 * NFT), so the category identifies a shard.
 *
 * Parameters:
 *   fundCategory: The fund token category
 */
contract ReserveVault(bytes32 fundCategory)
{
    /**
     * release(): Spend this reserve with its shard
     *
     * Ensures:
     * - The previous input is a shard of this fund
     * - It is this reserve's shard: the outpoint just before this one
     * - The reserve returns to this vault
     */
    function release() {
        int shardIndex = this.activeInputIndex - 1;
        require(tx.inputs[shardIndex].tokenCategory == fundCategory + 0x01, 'A reserve moves only with a shard');
        require(tx.inputs[shardIndex].outpointTransactionHash == tx.inputs[this.activeInputIndex].outpointTransactionHash, 'A reserve moves only with its own shard');
        require(tx.inputs[shardIndex].outpointIndex + 1 == tx.inputs[this.activeInputIndex].outpointIndex, 'A reserve moves only with its own shard');
        require(tx.outputs[this.activeInputIndex].lockingBytecode == tx.inputs[this.activeInputIndex].lockingBytecode);
    }
}
