pragma cashscript ^0.14.0;

/**
 * Authorization token checks shared by the contracts it gates.
 *
 * Authorization token commitment: [auth_type (1 byte)][permission_flags (2 bytes)][serial_number]
 * (see docs/agents/token-basket/v1/ENCODINGS.md for the permission bits).
 */

/**
 * hasAuthority(): Whether an input carries an authorization token granting a permission
 *
 * Parameters:
 *   authorization: Authorization token category
 *   permission: Permission bit(s) required, as 2 bytes (e.g. 0x0004)
 *
 * Authority held by the calling contract (its own input or another UTXO at its address) does not
 * count, so an authorization token sent to a contract cannot authorize its own release.
 */
function hasAuthority(bytes authorization, bytes permission) returns (bool) {
    bool authorized = false;
    int inputIndex = 0;
    do {
        if(tx.inputs[inputIndex].tokenCategory == authorization && tx.inputs[inputIndex].lockingBytecode != tx.inputs[this.activeInputIndex].lockingBytecode) {
            if((bytes(tx.inputs[inputIndex].nftCommitment.slice(1, 3)) & permission) == permission) {
                authorized = true;
            }
        }
        inputIndex = inputIndex + 1;
    } while(inputIndex < tx.inputs.length && !authorized);
    return authorized;
}
