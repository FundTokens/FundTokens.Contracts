pragma cashscript ^0.14.0;

import "./lib/authority.cash";

/**
 * InstanceVault: Holding vault for encoded FundToken contract parameters and on-chain proofs
 * 
 * Vault to store on-chain the instance parameters into a NFT token commitment.
 * Enables on-chain parameter validation and ensures contract parameters are always recoverable.
 * 
 * Parameters:
 *   instance: Token category of the holding NFT
 *   authorization: Token category that authorizes sensitive operations
 */
contract InstanceVault(bytes32 instance, bytes32 authorization)
{
    /**
     * burn(): Burn the tokens to signal this instance is no longer being used or maintained
     * 
     * Validates and aggregates all instance NFT commitment data, verifies the hash,
     * confirms authorization (bit 0x0080), and burns all instance tokens from outputs.
     * 
     * Notes:
     * - Instance parameters data can be recovered from transaction history even after burning
     * - Intended to signal for rare closure event only
     * - Requires authorization token with bit 0x0080 (instance deprecation permission)
     * - A pre-release or main instance must be marked deprecated or vulnerable first, so the
     *   instance is always seen retired before it disappears
     * 
     * Ensures:
     * - The instance state is deprecated (0x04) or vulnerable (0x08)
     * - Both inputs must be processed sequentially
     * - Authorization token (bit 0x0080) must be present somewhere in the transaction
     * - No instance tokens allowed in any output (complete token burn)
     */
    function burn() {
        // ensure only spends for expected token
        require(tx.inputs[this.activeInputIndex].tokenCategory == (instance + 0x01));
        // only a retired instance can be burned
        bytes meta, bytes hashAndData = tx.inputs[this.activeInputIndex].nftCommitment.split(4);
        bytes state = meta.slice(1, 2);
        require(state == 0x04 || state == 0x08, 'Only a deprecated or vulnerable instance can be burned');
        // build data
        bytes hash, bytes data = hashAndData.split(32);
        require(tx.inputs.length >= this.activeInputIndex + 2);
        int dataIndex = this.activeInputIndex + 1;
        require(tx.inputs[dataIndex].lockingBytecode == tx.inputs[this.activeInputIndex].lockingBytecode, 'Data input must spend from this lockingBytecode');
        data = data + tx.inputs[dataIndex].nftCommitment;

        // hash and verify
        require(hash256(data) == hash, 'Encoded hash and calculated hash must match');      

        // burn the tokens
        int outputIndex = 0;
        do {
            if(tx.outputs[outputIndex].tokenCategory != 0x) {
                require(tx.outputs[outputIndex].tokenCategory.split(32)[0] != instance);
            }
            outputIndex = outputIndex + 1;
        } while(outputIndex < tx.outputs.length);


        // check for authorization
        require(hasAuthority(authorization, 0x0080), "unauthorized user");
    }
    
    /**
     * update(): Updates state of instance composition on-chain
     * 
     * Validates that both instance inputs are properly preserved (allowing limited changes).
     * Aggregate NFT commitment data and verify the hash matches expected state.
     * 
     * Ensures:
     * - Active input (this UTXO) must be preserved allowing for a state change
     * - The next input must be in matching criteria
     * - Commitment data has mutable limitations
     * - Authorization token with bit 0x0040 (update instance state) is present
     * - The current state is not vulnerable: a vulnerable instance is terminal and can never change state
     * - The new state is a defined lifecycle state (pre-release, main, deprecated or vulnerable)
     */
    function update() {
        //
        // Check the starting input (and shortcut input validation because we know the length)
        require(tx.inputs.length >= this.activeInputIndex + 2);
        require(tx.inputs[this.activeInputIndex].tokenCategory == (instance + 0x01));

        //
        // Check for authorization: bit 0x0040 permits updating the instance state
        require(hasAuthority(authorization, 0x0040), "unauthorized user");

        //
        // Start splitting the input token and validate against the mutable output
        bytes type, bytes stateAndRest = tx.inputs[this.activeInputIndex].nftCommitment.split(1);
        bytes state, bytes versionAndRest = stateAndRest.split(1); // No need to validate the input's type
        require(state != 0x08, 'A vulnerable instance cannot change state');
        bytes o_type, bytes o_stateAndRest = tx.outputs[this.activeInputIndex].nftCommitment.split(1);
        require(o_type == type); // type cannot change
        bytes o_state, bytes o_versionAndRest = o_stateAndRest.split(1);
        require(o_state == 0x01 || o_state == 0x02 || o_state == 0x04 || o_state == 0x08); // state can change, to a defined lifecycle state
        require(o_versionAndRest == versionAndRest); // library version, hash, and data cannot change

        //
        // Build data and verify against the hash
        // Only two tokens expected, verify the next token is a data token w/ token preservation
        bytes hash, bytes data = versionAndRest.split(2)[1].split(32);

        int dataIndex = this.activeInputIndex + 1;
        require(tx.inputs[dataIndex].lockingBytecode == tx.inputs[this.activeInputIndex].lockingBytecode, 'Data input must spend from this lockingBytecode');
        require(tx.inputs[dataIndex].lockingBytecode == tx.outputs[dataIndex].lockingBytecode, 'Data input must be preserved');
        require(tx.inputs[dataIndex].tokenCategory == tx.outputs[dataIndex].tokenCategory, 'Data input category must be preserved');
        require(tx.inputs[dataIndex].nftCommitment == tx.outputs[dataIndex].nftCommitment, 'Data input commitment must be preserved');
        require(tx.inputs[dataIndex].tokenAmount == tx.outputs[dataIndex].tokenAmount, 'Data input amount must be preserved');

        //
        // Concate the data and verify the hash
        data = data + tx.inputs[dataIndex].nftCommitment;
        require(hash256(data) == hash, 'Encoded hash and calculated hash must match');

        //
        // return input to contract
        require(tx.inputs[this.activeInputIndex].lockingBytecode == tx.outputs[this.activeInputIndex].lockingBytecode, 'This input must be preserved');
        require(tx.inputs[this.activeInputIndex].tokenCategory == tx.outputs[this.activeInputIndex].tokenCategory, 'This input category must be preserved');
        require(tx.inputs[this.activeInputIndex].tokenAmount == tx.outputs[this.activeInputIndex].tokenAmount, 'This input amount must be preserved');
    }

    /**
     * proof(): Proves instance composition on-chain
     * 
     * Validates that both instance inputs are properly forwarded to matching outputs.
     * Aggregate NFT commitment data and verify the hash matches expected state.
     * 
     * Ensures:
     * - Active input (this UTXO) must forward without change
     * - The next input must be in matching criteria
     * - Commitment data is immutable (same in/out)
     */
    function proof() {
        //
        // Check the starting input (and shortcut input validation because we know the length)
        require(tx.inputs.length >= this.activeInputIndex + 2);
        require(tx.inputs[this.activeInputIndex].tokenCategory == (instance + 0x01));

        //
        // Start splitting this token and validate data as we go
        bytes hashAndData = tx.inputs[this.activeInputIndex].nftCommitment.split(4)[1]; // no need to validate meta here, it's for external tooling signaling
        bytes hash, bytes data = hashAndData.split(32);

        //
        // Only two tokens expected, verify the next token is a data token w/ token preservation
        int dataIndex = this.activeInputIndex + 1;
        require(tx.inputs[dataIndex].lockingBytecode == tx.inputs[this.activeInputIndex].lockingBytecode, 'Data input must spend from this lockingBytecode');
        require(tx.inputs[dataIndex].lockingBytecode == tx.outputs[dataIndex].lockingBytecode, 'Data input must be preserved');
        require(tx.inputs[dataIndex].tokenCategory == tx.outputs[dataIndex].tokenCategory, 'Data input category must be preserved');
        require(tx.inputs[dataIndex].nftCommitment == tx.outputs[dataIndex].nftCommitment, 'Data input commitment must be preserved');
        require(tx.inputs[dataIndex].tokenAmount == tx.outputs[dataIndex].tokenAmount, 'Data input amount must be preserved');

        //
        // Concate the data and verify the hash
        data = data + tx.inputs[dataIndex].nftCommitment;
        require(hash256(data) == hash, 'Encoded hash and calculated hash must match');

        //
        // return input to contract
        require(tx.inputs[this.activeInputIndex].lockingBytecode == tx.outputs[this.activeInputIndex].lockingBytecode, 'This input must be preserved');
        require(tx.inputs[this.activeInputIndex].tokenCategory == tx.outputs[this.activeInputIndex].tokenCategory, 'This input category must be preserved');
        require(tx.inputs[this.activeInputIndex].tokenAmount == tx.outputs[this.activeInputIndex].tokenAmount, 'This input amount must be preserved');
        require(tx.inputs[this.activeInputIndex].nftCommitment == tx.outputs[this.activeInputIndex].nftCommitment, 'This input commitment must be preserved');
    }

    /**
     * data(): Validates commitment data continuity in the proof chain
     * 
     * Ensures this UTXO is part of a continuous chain of instance proofs.
     * 
     * Ensures
     * - This input must contain instance token
     * - Previous input must have identical locking bytecode
     * - Previous input must have identical token category
     * - Previous input must be from the same transaction (outpointTransactionHash)
     */
    function data() {
        require(tx.inputs[this.activeInputIndex].tokenCategory == instance);
        int prevInput = this.activeInputIndex - 1;
        require(tx.inputs[this.activeInputIndex].outpointTransactionHash == tx.inputs[prevInput].outpointTransactionHash);
        require(tx.inputs[this.activeInputIndex].lockingBytecode == tx.inputs[prevInput].lockingBytecode);
    }
}