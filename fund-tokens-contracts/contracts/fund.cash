pragma cashscript ~0.13.0;

/**
 * FundManager (Fund): Maintains a fund's tokens for minting and redemptions
 * 
 * This contract maintains the supply of this fund's tokens.
 * Minting and redemption check for inflow/outflow token signals expecting a strict tx shape.
 * Efficient contract linking is used for scaling token inputs.
 * 
 * Parameters:
 *   inflowToken: Inflow token category (signals minting operation)
 *   outflowToken: Outflow token category (signals redemption operation)
 *   fundCategory: Fund token category held in this contract
 *   fundHash: Hash of fund parameters (ensures correct fund)
 */
contract FundManager(bytes32 inflowToken, bytes32 outflowToken, bytes fundCategory, bytes fundHash)
{    
    /**
     * mint(): Release fund tokens during inflow (user deposit)
     *
     * The heavy calculation work is deferred to the fund's TransactionManager (holder of the inflow/outflow tokens).
     * Look for the inflow token or another instance of this contract.
     * Ensure at least the leading contract is returned (i.e. at least one UTXO is returned for future redemptions).
     * 
     * Ensures:
     * - Linked to a FundManager or inflow token at expected input
     * - At least one output is returned (ready for redeem)
     * - If tokens are returned, then the token is the fund's
     */
    function mint() {
        //
        // Check for inflow and verify it's for this fund
        int prevInflowInput = this.activeInputIndex - 2;
        bool prevInflow = tx.inputs[prevInflowInput].tokenCategory == inflowToken && tx.inputs[prevInflowInput].nftCommitment == bytes(0x02 + fundCategory + fundHash);
        if(prevInflow) {
            int nextOutput = this.activeInputIndex + 1;
            require(tx.inputs[this.activeInputIndex].lockingBytecode == tx.outputs[nextOutput].lockingBytecode); // at least one UTXO is returned
            require(tx.outputs[nextOutput].tokenCategory == fundCategory || tx.outputs[nextOutput].tokenCategory == 0x);
        }

        //
        // Previous input must be the inflow token or another FundManager for this fund
        bool prevFundManager = tx.inputs[this.activeInputIndex - 1].lockingBytecode == tx.inputs[this.activeInputIndex].lockingBytecode;
        require(prevInflow || prevFundManager);
    }

    /**
     * redeem(): Collect fund tokens during outflow (user withdrawal)
     * 
     * The heavy calculation work is deferred tot he fund's TransactionManager.
     * Look for the outflow token or another instance of this contract.
     *
     * Ensures:
     * - Link to a FundManager or outflow token at expected input
     * - At least one output is returned
     * - Tokens returned are the fund's tokens
     */
    function redeem() {
        //
        // Check for outflow and verify it's for this fund
        int prevInflowInput = this.activeInputIndex - 2;
        bool prevOutflow = tx.inputs[prevInflowInput].tokenCategory == outflowToken && tx.inputs[prevInflowInput].nftCommitment == bytes(0x02 + fundCategory + fundHash);
        if(prevOutflow) {
            int nextOutput = this.activeInputIndex + 1;
            require(tx.inputs[this.activeInputIndex].lockingBytecode == tx.outputs[nextOutput].lockingBytecode);
            require(tx.outputs[nextOutput].tokenCategory == fundCategory);
        }

        //
        // Previous input must be outflow token or another FundManager for this fund
        int prevInput = this.activeInputIndex - 1;
        bool prevFundManager = tx.inputs[prevInput].lockingBytecode == tx.inputs[this.activeInputIndex].lockingBytecode;
        if(prevFundManager && tx.inputs[prevInput].tokenCategory != 0x) {
            require(tx.inputs[this.activeInputIndex].tokenCategory == fundCategory);
        }
        require(prevOutflow || prevFundManager);
    }
}