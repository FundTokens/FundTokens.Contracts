pragma cashscript ~0.13.0;

/**
 * FundInflowMint: Creates per-fund contract instance inflow tokens via bytecode extraction and token commitment verification
 * 
 * Vault for holding inflow minting tokens and ensures new minting follows strict requirements.
 *
 * Extract asset contract bytecode from this contract's activation bytecode:
 *   Push opcodes add ~2 bytes of overhead for >75 byte push
 *   Push opcodes add 1 byte of overhead for <75 byte push
 * 
 * Parameters:
 *   startupContract: Startup contract hash (thread startup verifier)
 *   inflowToken: Inflow token category (minting capability)
 *   outflowToken: Outflow token category (minting capability)
 *   fee: Fee contract hash
 *   managerContract: TransactionManager bytecode template
 *   fundContract: Fund contract bytecode template
 *   assetContract: Asset contract bytecode template
 */
contract FundInflowMint(bytes32 startupContract, bytes32 inflowToken, bytes32 outflowToken, bytes32 fee, bytes managerContract, bytes fundContract, bytes assetContract)
{
    /**
     * mintInflow(): Create Asset contract instance for inflow operations
     * 
     * Mints inflow token to newly calculated Asset contract address.
     * This asset manager controls fund deposits and token releases.
     * 
     * Ensures:
     * - Validator input precedes this mint
     * - This FundMint UTXO returns to itself with minting token
     * - Outflow token input present with minting capability
     * - Both inputs from same contract (prevents cross-fund confusion)
     * - Output receives correct Asset contract address and inflow token
     */
    function mint() {
        //
        // Verify validator and minting token in expected tx sequence
        require(tx.inputs[this.activeInputIndex - 1].lockingBytecode == new LockingBytecodeP2SH32(startupContract));
        require(tx.inputs[this.activeInputIndex + 1].tokenCategory == (outflowToken + 0x02));

        //
        // Validate this input/output
        bytes thisTokenCategory = tx.inputs[this.activeInputIndex].tokenCategory;
        require(thisTokenCategory == (inflowToken + 0x02));
        require(thisTokenCategory == tx.outputs[this.activeInputIndex].tokenCategory);
        require(tx.inputs[this.activeInputIndex].lockingBytecode == tx.outputs[this.activeInputIndex].lockingBytecode);
        require(tx.inputs[this.activeInputIndex].nftCommitment == tx.outputs[this.activeInputIndex].nftCommitment);

        //
        // Extract fund parameters from output NFT commitment and verify deployment
        int inflowOutput = this.activeInputIndex + 4;
        bytes tokenType, bytes categoryAndHash = tx.outputs[inflowOutput].nftCommitment.split(1);
        require(tokenType == 0x02);
        bytes fundCategory, bytes fundHash = categoryAndHash.split(32);
        
        int assetContractStop = assetContract.length + 2;
        bytes assetContractParam = this.activeBytecode.slice(0, assetContractStop);
        
        int fundContractStop = assetContractStop + fundContract.length + 2;
        bytes fundContractParam = this.activeBytecode.slice(assetContractStop, fundContractStop);

        //
        // Verify the mitned inflow token destination
        require(tx.outputs[inflowOutput].lockingBytecode == new LockingBytecodeP2SH32(hash256(assetContractParam + fundContractParam + 0x20 + fundHash + 0x20 + fundCategory + 0x20 + outflowToken + 0x20 + inflowToken + 0x20 + fee + managerContract)));
        require(tx.outputs[inflowOutput].tokenCategory == inflowToken);
    }
}