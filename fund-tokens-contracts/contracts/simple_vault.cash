pragma cashscript ~0.13.0;

/**
 * SimpleVault: A simple gated vault with token authorization
 * 
 * Holds assets that can only be spent when a the authorization token is present in the transaction.
 * 
 * Parameters:
 *   authToken: Token category that authorizes releasing
 */
contract SimpleVault(bytes32 authToken)
{
    /**
     * release(): Allows spending only when authToken is present
     *
     * Release is dependent only on the authorization token being found in the tx w/ the correct permission bit.
     *
     * Ensures:
     * - Authorization token exists in tx w/ correct permission bit
     */
    function release() {
        //
        // Check if authorization token is present in ANY input with permission bit 0x0080
        bool authorized = false;
        int inputIndex = 0;
        do {
            if(tx.inputs[inputIndex].tokenCategory == authToken) {
                if((bytes(tx.inputs[inputIndex].nftCommitment.slice(1, 3)) & bytes(0x0080)) == 0x0080) {
                    authorized = true;
                }
            }
            inputIndex = inputIndex + 1;
        } while(inputIndex < tx.inputs.length && !authorized);
        require(authorized, "unauthorized user");
    }

    /**
     * verify(): An efficient contract linking method to rely on the first UTXO to authorize release
     *
     * Ensures:
     * - Previous input was spent from this contract
     */
    function verify() {
        require(tx.inputs[this.activeInputIndex - 1].lockingBytecode == tx.inputs[this.activeInputIndex].lockingBytecode);
    }
}