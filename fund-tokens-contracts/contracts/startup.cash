pragma cashscript ~0.13.0;

/**
 * FundStartup: Validates and initializes a new fund
 * 
 * Called once during fund creation and to create additional threads. Mints inflow/outflow tokens and validates
 * all fund parameters including amounts, satoshis, and asset ordering.
 * 
 * Fund data format (passed as bytes):
 * [fund_category (32) | fund_amount (8) | satoshis (8) | 
 *  asset1_category (32) | asset1_amount (8) | ... | assetN_category (32) | assetN_amount (8)]
 * 
 * Parameters:
 *   fee: Fee contract hash (for fee input verification)
 *   inflowToken: Inflow token category to mint (with minting capability)
 *   outflowToken: Outflow token category to mint (with minting capability)
 */
contract FundStartup(bytes32 fee, bytes32 inflowToken, bytes32 outflowToken)
{
    /**
     * start(bytes fund): Validates fund parameters and mints tokens
     * 
     * Validates:
     * - Fund amount > 0
     * - Satoshis in valid range
     * - Assets are sorted by category ascending
     * - Each asset amount > 0
     * 
     * Creates:
     * - Inflow token NFT with fund commitment
     * - Outflow token NFT with fund commitment
     */
    function start(bytes fund) {
        // Parse fund parameters from commitment bytes
        bytes nft_fundCategory, bytes nft_next1 = fund.split(32); // no fund category is assumed correct here

        // Mint inflow and outflow tokens with fund commitment (fund_category | fund_hash)
        int mintedInflowOutput = this.activeInputIndex + 5;
        int mintedOutflowOutput = this.activeInputIndex + 6;
        bytes fundHash = hash256(fund);
        bytes commitment = 0x02 + nft_fundCategory + fundHash;
        require(tx.outputs[mintedOutflowOutput].nftCommitment == commitment);        
        require(tx.outputs[mintedInflowOutput].nftCommitment == commitment);
        require(tx.outputs[mintedOutflowOutput].tokenCategory == outflowToken);
        require(tx.outputs[mintedInflowOutput].tokenCategory == inflowToken);

        bytes nft_fundAmount, bytes nft_next2 = nft_next1.split(8);
        // Fund amount must be > 0 (determines token divisor)
        require(int(nft_fundAmount) > 0);
        bytes nft_satoshis, bytes nft_assets = nft_next2.split(7);

        if(nft_assets.length > 0) {
            // Satoshis must be within Bitcoin supply range (0 sat to 21 million BTC)
            require(within(int(nft_satoshis), 0 sats, 21000000 bitcoin));

            // Verify assets are sorted ascending by category
            bytes lastAssetCategory = 0x;
            do {
                bytes nft_assetCategory, bytes nft_next3 = nft_assets.split(32);
                bytes nft_assetAmount, bytes nft_next4 = nft_next3.split(8);
                // Each asset must have amount > 0
                require(int(nft_assetAmount) > 0);

                // Assets must be in ascending order for deterministic sorting
                if(lastAssetCategory != 0x) { // The first asset
                    require(int(lastAssetCategory + 0x00) < int(nft_assetCategory + 0x00));
                }

                nft_assets = nft_next4;
                lastAssetCategory = nft_assetCategory;
            } while(nft_assets.length > 0);
        } else {
            // Satoshis must be within Bitcoin supply range (1 sat to 21 million BTC)
            require(within(int(nft_satoshis), 1 sats, 21000000 bitcoin));
        }

        // Verify inflow and outflow token input (with minting capability)
        require(tx.inputs[this.activeInputIndex + 1].tokenCategory == bytes(inflowToken + 0x02));
        require(tx.inputs[this.activeInputIndex + 2].tokenCategory == bytes(outflowToken + 0x02));

        // Verify fee contract input
        int feeContractInput = this.activeInputIndex + 3;
        bytes feeContractInputBytecode = tx.inputs[feeContractInput].lockingBytecode;
        require(feeContractInputBytecode == new LockingBytecodeP2SH32(fee));
        require(feeContractInputBytecode == tx.outputs[feeContractInput].lockingBytecode); // sends back to self, it's paid

        // Ensure no other outputs mint inflow/outflow tokens
        int outputIndex = 0;
        do {
            if(!within(outputIndex, this.activeInputIndex, this.activeInputIndex + 7)) {
                if(tx.outputs[outputIndex].tokenCategory != 0x) {
                    // No other outputs can mint inflow or outflow tokens
                    bytes outputCategory = tx.outputs[outputIndex].tokenCategory.slice(0, 32);
                    require(outputCategory != inflowToken);
                    require(outputCategory != outflowToken);
                }
            }
            outputIndex = outputIndex + 1;
        } while(outputIndex < tx.outputs.length);

        // This startup UTXO returns to itself, no tokens needed
        require(tx.inputs[this.activeInputIndex].lockingBytecode == tx.outputs[this.activeInputIndex].lockingBytecode);
    }
}