pragma cashscript ~0.13.0;

/**
 * PublicFund: Broadcasts and validates new public funds that are verified and created on-chain
 * 
 * Defers fund makup validation to startup contract.
 * Validates minted operating tokens and fund data encoding.
 * Chunks fund data into individual outputs for blockchain visibility and allows contract parameters recovery.
 * 
 * Parameters:
 *   authHeadDestination: AuthHeadVault output destination
 *   publicFundDestination: PublicFund token destination (vault and on-chain proofing)
 *   token: The "PublicFund" token used to signal trustlessly created public funds
 *   startupContract: FundStartup contract hash (verifies fund creation)
 *   fundContract: Fund manager bytecode template
 *   inflowToken: Inflow token category
 *   outflowToken: Outflow token category
 */
contract PublicFund(bytes authHeadDestination, bytes publicFundDestination, bytes32 token, bytes32 startupContract, bytes fundContract, bytes32 inflowToken, bytes32 outflowToken)
{   
    /**
     * broadcast(): Verify new token safely created and broadcast fund parameters
     * 
     * Broadcasting encodes public fund details into a series of NFT commitments.
     * Verifies the user did not create additional system tokens or fund tokens.
     * Only one new public fund can be created per transaction.
     * 
     * Ensures:
     * - Genesis input (index 0) has no tokens and outpointIndex == 0
     * - Fund category matches genesis input transaction hash
     * - Fund amount > 0
     * - Satoshis in valid range
     * - Assets sorted ascending by category
     * - Each asset amount > 0
     * - Transaction manager contract properly calculated from fund parameters
     * - No unauthorized token minting
     */
    function broadcast() {
        //
        // Verify genesis input (first input) is confirmed for fund creation
        require(tx.inputs[0].outpointIndex == 0);
        require(tx.inputs[0].tokenCategory == 0x);

        //
        // Verify identity output is sent to our identity vault
        require(tx.outputs[0].lockingBytecode == authHeadDestination);
        require(tx.outputs[0].tokenCategory == 0x);

        //
        // Verify startup contract is in expect tx sequence
        require(tx.inputs[this.activeInputIndex - 4].lockingBytecode == new LockingBytecodeP2SH32(startupContract));        

        //
        // Chunk fund into X-byte pieces and store in output NFT commitments
        // Each chunk goes into an output as NFT commitment data
        // Assuming selfish behavior and being as efficient as possible
        bytes fundCommitment = 0x;
        int broadcastOutputEnd = this.activeInputIndex + 5;
        bool break = false;
        int firstCommitmentLength = -1;
        int lastCommitmentLength = -1;
        while(tx.outputs.length > broadcastOutputEnd && !break) {
            if(tx.outputs[broadcastOutputEnd].tokenCategory == token) {
                require(tx.outputs[broadcastOutputEnd].lockingBytecode == publicFundDestination);

                //
                // Ensure the first commitment sets the max size
                // Only the last token can be smaller than the first
                int thisCommitmentLength = tx.outputs[broadcastOutputEnd].nftCommitment.length;
                if(firstCommitmentLength == -1) {
                    firstCommitmentLength = thisCommitmentLength;
                }
                require(firstCommitmentLength >= thisCommitmentLength);
                if(lastCommitmentLength != -1) {
                    require(firstCommitmentLength == lastCommitmentLength);
                }
                lastCommitmentLength = thisCommitmentLength;

                //
                // Advance commitment and index var
                fundCommitment = fundCommitment + tx.outputs[broadcastOutputEnd].nftCommitment;
                broadcastOutputEnd = broadcastOutputEnd + 1;
            } else {
                break = true;
            }
        }

        //
        // Verify no unauthorized token minting, efficiently check by skipping verified outputs
        int outputIndex = 1; // 0 (authhead) already validated
        do {
            if(!within(outputIndex, this.activeInputIndex - 4, broadcastOutputEnd)) { // skip the expected tx sequence
                if(tx.outputs[outputIndex].tokenCategory != 0x) {
                    //
                    // No minting fund tokens or system tokens outside of our tx
                    bytes category = tx.outputs[outputIndex].tokenCategory.slice(0, 32);
                    require(category != tx.inputs[0].outpointTransactionHash);
                    require(category != token);
                }
            }
            outputIndex = outputIndex + 1;
        } while(outputIndex < tx.outputs.length);

        //
        // Start parsing fund details and verify
        bytes type, bytes hashAndData = fundCommitment.split(1);
        require(type == 0x02);
        bytes fundHash, bytes fund = hashAndData.split(32);
        require(fundHash == hash256(fund));

        //
        // Verify the fund token category based on the provided genesis input
        bytes nft_fundCategory = fund.slice(0, 32);
        require(nft_fundCategory == tx.inputs[0].outpointTransactionHash);
        bytes expectedCommitment = 0x02 + nft_fundCategory + fundHash; // startup contract relies on this contract to verify the commitment encoding
        require(tx.outputs[this.activeInputIndex + 1].nftCommitment == expectedCommitment);
        require(tx.outputs[this.activeInputIndex + 2].nftCommitment == expectedCommitment);

        //
        // Verify the fund token is minted and routed to the fund manager
        int transactionManagerOutput = this.activeInputIndex + 3;
        require(tx.outputs[transactionManagerOutput].lockingBytecode == new LockingBytecodeP2SH32(hash256(0x20 + fundHash + 0x20 + nft_fundCategory + 0x20 + outflowToken + 0x20 + inflowToken + fundContract)));
        require(tx.outputs[transactionManagerOutput].tokenCategory == tx.inputs[0].outpointTransactionHash);
        require(tx.outputs[transactionManagerOutput].tokenAmount == 9223372036854775807); // int64, max positive value

        //
        // Verify this spending input and the UTXO is preserved
        require(tx.inputs[this.activeInputIndex].tokenCategory == bytes(token + 0x02));
        int thisOutput = this.activeInputIndex + 4;
        require(tx.inputs[this.activeInputIndex].lockingBytecode == tx.outputs[thisOutput].lockingBytecode);
        require(tx.inputs[this.activeInputIndex].tokenCategory == tx.outputs[thisOutput].tokenCategory);
        require(tx.inputs[this.activeInputIndex].nftCommitment == tx.outputs[thisOutput].nftCommitment);
    }
}
