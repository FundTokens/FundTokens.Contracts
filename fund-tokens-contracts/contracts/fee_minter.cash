pragma cashscript ~0.13.0;

/**
 * FeeMinter: Vault to holding fee minting token with strict minting enforcement and authorization requirements
 * 
 * Minting fee tokens provides a way to compose a flexible fee structure into the protocol.
 * Operations are authorized via token using commitment as permission bits.
 * 
 * Parameters:
 *   authorization: Token category that authorizes operations
 *   token: Fee token category being minted
 *   next: Destination for newly minted fee tokens (fee enforcement contract)
 */
contract FeeMinter(bytes32 authorization, bytes32 token, bytes next)
{
    /**
     * mint(): Mints fee tokens with commitment encoding
     * 
     * Acts as a vault for long term fee token holding.
     * Allows authorized fee token minting to FeeManager with NFT commitment structure validation.
     * Ensures this minting token UTXO is preserved
     *
     * Ensures:
     * - Action is authorized with permission bit 0x0010
     * - Enforces minted tokens destination to FeeManager
     * - Ensures proper NFT commitment structure (type and additional data as needed)
     */
    function mint() {
        //
        // Check for authorization token in ANY input
        // Bit 0x0010 in commitment indicates fee minting permission
        bool authorized = false;
        int inputIndex = 0;
        do {
            if(tx.inputs[inputIndex].tokenCategory == authorization) {
                if((bytes(tx.inputs[inputIndex].nftCommitment.slice(1, 3)) & bytes(0x0010)) == 0x0010) {
                    authorized = true;
                }
            }
            inputIndex = inputIndex + 1;
        } while(inputIndex < tx.inputs.length && !authorized);
        require(authorized, "unauthorized user");

        //
        // Verify ALL outputs with locking bytecode enforcement
        int outputIndex = 0;
        do {
            if(outputIndex != this.activeInputIndex && tx.outputs[outputIndex].tokenCategory != 0x) {
                if(tx.outputs[outputIndex].tokenCategory.slice(0, 32) == token) {
                    //
                    // Validate minted token output including NFT commitment
                    require(tx.outputs[outputIndex].lockingBytecode == next);
                    require(tx.outputs[outputIndex].tokenCategory == token);

                    bytes fee_type, bytes fee_next0 = tx.outputs[outputIndex].nftCommitment.split(1);
                    require(fee_type == 0x01 || fee_type == 0x02); // minting type not allowed

                    if(fee_type == 0x01) {
                        bytes fee_category, bytes fee_next1 = fee_next0.split(32);
                        require(fee_category != 0x);
                        
                        bytes fee_amount = fee_next1.slice(0, 8);
                        require(int(fee_amount + 0x00) > 0); // treat as uint
                        
                        // Destination is optional (0x for default, or locking bytecode)
                    }

                    if(fee_type == 0x02) {
                        require(fee_next0 == 0x); // No additional commitment needed
                    }
                }
            }
            outputIndex = outputIndex + 1;
        } while(outputIndex < tx.outputs.length);


        //
        // Verify this is a fee minting token and the UTXO is preserved
        bytes thisInputCategory = tx.inputs[this.activeInputIndex].tokenCategory;
        require(thisInputCategory == (token + 0x02));
        require(thisInputCategory == tx.outputs[this.activeInputIndex].tokenCategory);
        require(tx.inputs[this.activeInputIndex].lockingBytecode == tx.outputs[this.activeInputIndex].lockingBytecode);
        require(tx.inputs[this.activeInputIndex].nftCommitment == tx.outputs[this.activeInputIndex].nftCommitment);
    }
}